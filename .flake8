[flake8]
# Maximum line length
max-line-length = 100

# Exclude directories and files
exclude = 
    .git,
    __pycache__,
    venv,
    .venv,
    build,
    dist,
    .eggs,
    .pytest_cache,
    .mypy_cache,
    htmlcov,
    migrations,
    .vscode,
    .idea

# Ignore specific error codes:
# E203: whitespace before ':'
# W503: line break before binary operator
# W504: line break after binary operator
ignore = E203,W503,W504

# Enable docstring convention checking
docstring-convention = google

# Complexity threshold
max-complexity = 10

# Show counts for violations
statistics = True
