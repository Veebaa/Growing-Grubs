# Growing Grubs Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# Flask Configuration
# ============================================================================

# Environment: development, production, or testing
FLASK_ENV=development

# Secret key for session signing and CSRF protection
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-in-production

# CSRF protection secret key
WTF_CSRF_SECRET_KEY=your-csrf-secret-key-here

# Debug mode (only use True in development)
DEBUG=False

# ============================================================================
# Database Configuration
# ============================================================================

# Database URL for SQLAlchemy
# Examples:
#   - SQLite (development): sqlite:///./mod/database.db
#   - PostgreSQL: postgresql://user:password@localhost/db_name
#   - MySQL: mysql+pymysql://user:password@localhost/db_name
DATABASE_URL=sqlite:///./mod/database.db

# Enable SQL query logging (development only)
SQLALCHEMY_ECHO=False

# ============================================================================
# External APIs
# ============================================================================

# NHS API Key for health topics feature
# Get from: https://api.service.nhs.uk/
NHS_API_KEY=your-nhs-api-key-here

# Nutritionix API Key (if using nutritional information)
# Get from: https://www.nutritionix.com/api
NUTRITIONIX_API_KEY=your-nutritionix-api-key-here

# ============================================================================
# Logging Configuration
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file location (absolute or relative path)
LOG_FILE=logs/app.log

# Error log file location
ERROR_LOG_FILE=logs/error.log

# Maximum log file size before rotation (in bytes, default: 10MB)
LOG_FILE_SIZE=10485760

# Number of backup log files to keep
LOG_BACKUP_COUNT=10

# ============================================================================
# Session Configuration
# ============================================================================

# Session type: filesystem, redis, etc.
SESSION_TYPE=filesystem

# Session lifetime in seconds (default: 7 days)
PERMANENT_SESSION_LIFETIME=604800

# ============================================================================
# Security Configuration
# ============================================================================

# HTTPS only cookies (set to True in production)
SESSION_COOKIE_SECURE=False

# HttpOnly flag for cookies (recommended: True)
SESSION_COOKIE_HTTPONLY=True

# SameSite policy for cookies (Strict, Lax, None)
SESSION_COOKIE_SAMESITE=Lax

# ============================================================================
# Feature Flags
# ============================================================================

# Enable debug routes (development only)
ENABLE_DEBUG_ROUTES=True

# Enable email notifications (if implemented)
ENABLE_EMAIL_NOTIFICATIONS=False

# ============================================================================
# Email Configuration (if using email notifications)
# ============================================================================

# Email server configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-email-password

# Sender email address
MAIL_DEFAULT_SENDER=noreply@growinggrubs.com

# ============================================================================
# Rate Limiting Configuration
# ============================================================================

# API rate limit (requests per second)
API_RATE_LIMIT=1.0

# Maximum retries for failed API requests
API_MAX_RETRIES=3

# API request timeout in seconds
API_REQUEST_TIMEOUT=10
